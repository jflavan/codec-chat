		"serialize-javascript": ">=7.0.5",
		"stringify-object": ">=6.0.0",
		"type-fest": ">=4.0.0 <5.0.0",
		"whatwg-url": ">=14.0.0",
		"which": ">=5.0.0",
		"ws": ">=7.5.11 <8.0.0"
	}
